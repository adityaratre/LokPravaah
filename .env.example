# Browser-safe Supabase configuration only. Never put service-role or AI provider keys here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Optional: real public HTTPS website origin for canonical metadata and sitemap generation.
VITE_SITE_URL=

# Voluntary donation checkout (public values only). Leave blank until the gateway is deployed.
# Portal serves /youpi.js and the hosted checkout experience.
VITE_DONATION_GATEWAY_PORTAL_URL=https://lokpravaah.online
# API base that exposes POST /api/v1/payments; can match the portal URL if proxied together.
VITE_DONATION_GATEWAY_API_URL=https://lokpravaah.online
# Public merchant identifier only; never paste a private webhook or service-role secret here.
VITE_DONATION_MERCHANT_KEY=
