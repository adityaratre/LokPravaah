# LokPravaah UPI Gateway — copy to .env, then replace every CHANGE_ME/placeholder.
NODE_ENV=production
YOUPI_MODE=production
# Used by local/Cloudflare tunnel startup; not required on Render.
CLOUDFLARE_DOMAIN=example.com
LOKPRAVAAH_FRONTEND_ORIGIN=https://YOUR-LOKPRAVAAH-DOMAIN.example
DEPLOYMENT_PREFIX=pay
CONTROL_CENTER_PORT=8090
PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001
GMAIL_OBSERVER_PORT=6003
SMS_OBSERVER_PORT=6002
BASE_PAYMENT_API_URL=https://pay-api.example.com
BASE_CHECKOUT_URL=https://pay.example.com
BASE_ADMIN_URL=https://pay-admin.example.com
BASE_HELP_URL=https://pay-help.example.com

# This checked-in gateway implementation uses the bundled SQLite database. DATABASE_URL is not wired to a PostgreSQL adapter in this version. Keep database files private.
# On Render, mount a persistent disk at the gateway data directory before production use.
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/lokpravaah_upi.sqlite
DATABASE_URL=

# Generate unique secrets before production. Never put these in Vite variables or public tables.
ENCRYPTION_MASTER_KEY=CHANGE_ME_64_HEX_CHAR_KEY
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_API_TOKEN=CHANGE_ME_ADMIN_API_TOKEN
OBSERVER_API_TOKEN=CHANGE_ME_OBSERVER_API_TOKEN
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN
LOKPRAVAAH_DONATION_WEBHOOK_SECRET=CHANGE_ME_USE_THE_SAME_RANDOM_SECRET_IN_SUPABASE_EDGE_FUNCTIONS
INITIAL_ADMIN_EMAIL=payments-admin@example.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD

# Render can route checkout, API, admin, and Gmail paths through one public service URL.
# On Render, RENDER_EXTERNAL_URL is discovered automatically; these can override it.
# PUBLIC_BASE_URL=
# BASE_CHECKOUT_URL=
# BASE_PAYMENT_API_URL=
# BASE_ADMIN_URL=
# BASE_GMAIL_URL=
# ENABLE_GMAIL_OBSERVER=false
# ENABLE_SMS_OBSERVER=false

# Used only when initializing a fresh gateway database.
DEFAULT_APP_NAME="LokPravaah"
DEFAULT_PRIMARY_COLOR="#55d8a1"
DEFAULT_SUPPORT_EMAIL="CHANGE_ME_REAL_SUPPORT_EMAIL"
LOKPRAVAAH_DONATION_WEBHOOK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/donation-webhook

# Configure a real Google account only if you use Gmail payment observation.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://pay-gmail.example.com/oauth/callback
GMAIL_POLL_INTERVAL_MS=5000
SMS_OBSERVER_POLL_INTERVAL_MS=3000
ANDROID_ENROLLMENT_SECRET=CHANGE_ME_LONG_RANDOM_ANDROID_ENROLLMENT_SECRET
ANDROID_HEARTBEAT_TIMEOUT_MS=180000
WEBHOOK_MAX_RETRIES=5
WEBHOOK_INITIAL_BACKOFF_MS=5000
