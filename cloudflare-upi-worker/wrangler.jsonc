{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lokpravaah-upi-gateway",
  "main": "src/index.js",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/api/*", "/checkout/*", "/admin", "/admin/*", "/youpi.js"]
  },
  "vars": {
    "LOKPRAVAAH_FRONTEND_ORIGIN": "https://lokpravaah.online",
    "MERCHANT_ID": "00000000-0000-0000-0000-000000000001",
    "PUBLIC_BASE_URL": "https://pay.lokpravaah.online",
    "PAYMENT_SESSION_MINUTES": "15"
  }
}
